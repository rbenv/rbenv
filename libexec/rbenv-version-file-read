#!/usr/bin/env bash
# Usage: rbenv version-file-read <file>
set -e
[ -n "$RBENV_DEBUG" ] && set -x

VERSION_FILE="$1"

if [ -s "$VERSION_FILE" ]; then
  # Read the first word from the specified version file. Avoid reading it whole.
  IFS="${IFS}"$'\r'
  read -n 1024 -d "" -r version rest <"$VERSION_FILE" || :
  # Strip a UTF-8 byte order mark, as written by some Windows editors. If the
  # mark was followed by whitespace, the version is the next non-empty word.
  # (Empty words are skipped because bash 3.2 keeps a leading "\r" in $rest.)
  bom=$'\xef\xbb\xbf'
  if [[ $version == "$bom"* ]]; then
    version="${version#"$bom"}"
    if [ -z "$version" ]; then
      set -f
      # shellcheck disable=SC2086
      for version in $rest; do
        [ -z "$version" ] || break
      done
      set +f
    fi
  fi

  if [ "$version" = ".." ] || [[ $version == */* ]]; then
    echo "rbenv: invalid version in \`$VERSION_FILE'" >&2
  elif [ -n "$version" ]; then
    echo "$version"
    exit
  fi
fi

exit 1
